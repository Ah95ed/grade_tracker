{
  "name": "daragat-worker-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply daragat --local",
    "db:migrate:remote": "wrangler d1 migrations apply daragat --remote",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "hono": "^4.7.10",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261123.1",
    "@types/node": "^22.14.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2",
    "wrangler": "^4.14.1"
  }
}
