# ===== أسرار السيرفر (لا تضعها هنا ولا في الكود) =====
# تُضاف فقط في Cloudflare Pages > Settings > Variables and Secrets (نوع Secret):
#   GEMINI_API_KEYD   = مفتاح Gemini الأساسي (تقرؤه دالة functions/api/extract-students.ts)
#   GEMINI_API_KEYA   = مفتاح Gemini الاحتياطي الثاني (يتم التبديل إليه تلقائياً عند وجود ضغط أو انتهاء الحصة على المفتاح الأول)
# أسماء بديلة مدعومة تلقائياً للمطابقة مع أي إعداد سابق: GEMINI_APK_KEYd, API_KEY_GEMINIA, GEMINI_API_KEY
# متغيرات اختيارية للسيرفر:
#   ADMIN_EMAILS         = إيميلات المشرفين مفصولة بفاصلة (الافتراضي: asmaomar5566@gmail.com). يشترط بريداً موثّقاً.
#   FIREBASE_PROJECT_ID  = فقط إذا كان مشروع Firebase في الإنتاج يختلف عن firebase-applet-config.json

# ===== إعدادات الواجهة (تظهر في المتصفح، لذلك لا تضع فيها أي سر) =====
APP_URL="https://your-domain.example"

# Firebase Client Configuration (اختياري: تتجاوز firebase-applet-config.json)
VITE_FIREBASE_API_KEY="your-firebase-api-key"
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-firebase-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="your-sender-id"
VITE_FIREBASE_APP_ID="your-app-id"

# بيانات التواصل المعروضة للمستخدمين
VITE_SUPPORT_PHONE="07XXXXXXXXX"
VITE_SUPPORT_WHATSAPP="964XXXXXXXXXX"
